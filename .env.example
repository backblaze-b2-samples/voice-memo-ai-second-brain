# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_KEY_ID=YOUR_KEY_ID_HERE
# B2_APPLICATION_KEY=K001_EXAMPLE_NOT_A_REAL_KEY_xxxxxxxxxxxx
# B2_BUCKET_NAME=my-app-uploads

# Optional: if your bucket is configured for public access, set the base URL
# below so the API returns directly-renderable URLs alongside object metadata.
# B2_PUBLIC_URL=https://example.cdn/my-bucket

# API server (optional — defaults shown match services/api/app/config/settings.py)
# Port the FastAPI server binds to.
# API_PORT=8000
# Comma-separated allowlist of frontend origins (CORS). Production should
# override with the exact frontend origin; the default covers `pnpm dev:web`
# on :3000 and the :3001 fallback Next picks when 3000 is busy.
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional dev-only escape hatch: a regex matching additional allowed
# origins (e.g. `^http://localhost:\d+$`). Empty by default. NEVER ship
# this to production.
# API_CORS_ORIGIN_REGEX=
# Maximum upload size in bytes for /upload and /memos (default 100 MiB).
# MAX_FILE_SIZE=104857600
# Path to the small durable JSON counter file used for download stats.
# Point at a persistent volume in production if you want it to survive
# restarts.
# DOWNLOAD_COUNT_FILE=data/download_count.json

# OpenAI (required) — drives Whisper transcription, tag/keyword extraction,
# embeddings for cross-references, and AI summary generation.
OPENAI_API_KEY=your_openai_api_key

# Optional model overrides (defaults shown)
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
